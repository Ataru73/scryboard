{
  "name": "@scryboard/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "prune": "tsx --env-file-if-exists=.env src/prune.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@hocuspocus/extension-database": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "@hono/node-server": "^2.1.5",
    "@scryboard/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "ws": "^8.22.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.7.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
