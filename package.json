{
  "name": "scryboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --recursive build",
    "start": "pnpm --filter @scryboard/server start",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck && tsc -p tsconfig.json",
    "lint": "biome check .",
    "portraits": "node scripts/portraits.mjs",
    "format": "biome check --write .",
    "e2e": "pnpm build && playwright test",
    "e2e:perf": "pnpm build && PERF=1 playwright test --grep @perf"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@hocuspocus/provider": "^4.7.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "yjs": "^13.6.33"
  }
}
